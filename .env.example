# Copy to .env for local use. Keep real credentials out of this template.
# Compose reads .env automatically for variable substitutions.
# For python -m app, export these variables in your shell first.

# Standalone bind settings; Compose fixes its container port to 8080.
HOST=0.0.0.0
PORT=8080

# Shared application settings used by Compose and standalone runs.
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO
ENVIRONMENT=development
APP_VERSION=1.0.0

# Standalone drain timeout in seconds; Compose fixes this to 20 seconds.
# Keep the container stop grace period greater than the drain timeout.
SHUTDOWN_TIMEOUT=20
